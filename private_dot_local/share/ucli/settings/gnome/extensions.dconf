[Logo-menu]
hide-softwarecentre=true
menu-button-extensions-app='com.mattjakeman.ExtensionManager.desktop'
menu-button-icon-image=6
menu-button-icon-size=16
menu-button-software-center='shelly'
menu-button-system-monitor='flatpak run io.missioncenter.MissionCenter'
menu-button-terminal='ghostty'
show-activities-button=true
show-lockscreen=true
symbolic-icon=true
use-custom-icon=false

[bettertrayicons]
app-config-sync-meta='{"entries":{"shelly-notifications":{"m":1793646796845,"h":"eedf7083"}},"tombstones":{}}'
app-configs='{"shelly-notifications":{"title":"Shelly Notifications","detected_icon":"shelly-shell-symbolic","seen_icons":["shelly-shell-symbolic","shelly-tray"],"is_hidden":false}}'
minimize-when-focused=false
overflow-layout-mode='row'
visible-icon-limit=0

[blur-my-shell]
settings-version=8

[blur-my-shell/applications]
blur=false
pipeline='pipeline_default'
whitelist=['com.mitchellh.ghostty', 'org.gnome.Nautilus']

[caffeine]
cli-toggle=false
indicator-position-max=2
user-enabled=true

[chromaleon]
accent-color='#798186'
custom-color=false
gnome-colors=false
user-themes-warning=false

[color-picker]
color-history=[uint32 1842207]

[copyous]
auto-hide-search=true
clipboard-orientation='vertical'
clipboard-position-horizontal='top'
clipboard-position-vertical='fill'
clipboard-size=500
database-backend='json'
disable-hljs-dialog=false
dynamic-item-height=true
header-controls-visibility='visible-on-hover'
item-height=100
item-width=300
show-at-pointer=true
show-header=false

[copyous/file-item]
file-preview-visibility='file-info'

[copyous/link-item]
link-preview-orientation='horizontal'

[dash-to-dock]
background-opacity=0.80000000000000004
custom-theme-shrink=true
dash-max-icon-size=48
dock-position='BOTTOM'
height-fraction=0.90000000000000002
preferred-monitor=-2
preferred-monitor-by-connector='eDP-1'
show-show-apps-button=false

[gnome-ui-tune]
increase-thumbnails-size='100%'

[gsconnect]
devices=['d2e92ffa10dd4e1a994871ace1e2b1e9']
missing-openssl=false
name='arch'
show-indicators=false

