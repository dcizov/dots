#!/usr/bin/env bash
set -euo pipefail

JUSTFILE="${UCLI_JUSTFILE:-$HOME/.config/ucli/justfile}"

# `--choose` delegates to `just --choose`, which uses fzf by default
# (overridable via JUST_CHOOSER). Matches ujust behavior: `ujust --choose`
# opens an interactive fzf menu over all public recipes. Underscore-prefixed
# recipes are hidden automatically.

args=()
for a in "$@"; do
  case "$a" in
    --choose|--choose=*) choose=1 ;;
    *) args+=("$a") ;;
  esac
done

JUST_DIR="$(dirname "$JUSTFILE")"

if [ "${choose:-0}" = 1 ]; then
  if [ ! -t 0 ]; then
    printf 'ucli: --choose needs a terminal (try `ucli usage` for the plain list)\n' >&2
    exit 2
  fi
  exec just --justfile "$JUSTFILE" --working-directory "$JUST_DIR" --choose
fi

exec just --justfile "$JUSTFILE" --working-directory "$JUST_DIR" "$@"
