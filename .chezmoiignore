{{- $terminal := index . "terminal" | default "none" -}}
{{- $desktop := index . "desktop" | default "none" -}}
{{- $role := index . "role" | default "dev" -}}

# Only paths this repo actually ships are listed here. If you add a terminal- or
# desktop-specific tree later (kitty/ghostty/hypr/gtk/kde), gate it on
# `$terminal` / `$desktop` from .chezmoi.toml.tmpl the same way.
README.md
AGENT_HANDOFF.md
*.tar.gz
*.zip
*.bak

# Bootstrap installer, served by install.wtfaq.tech
install.sh

# Terminal-specific configs: only deploy the terminal you actually use.
{{- if ne $terminal "ghostty" -}}
.config/ghostty/
{{- end -}}
{{- if ne $terminal "kitty" -}}
.config/kitty/
{{- end -}}

# Dev box: only deploy distrobox config if the role is dev.
{{- if ne $role "dev" -}}
.config/distrobox/
{{- end -}}