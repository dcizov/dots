{{- if eq .chezmoi.os "linux" -}}
#!/usr/bin/env bash
set -euo pipefail

# The four zsh plugins live in ONE place: $ZSH_CUSTOM/plugins (default
# ~/.oh-my-zsh/custom/plugins). oh-my-zsh loads them from there through the
# plugins=(...) array in ~/.zshrc, on the host and inside the dev box alike —
# the dev box's provision-dev.sh clones the same list, so this only has to fill
# in what is missing. Installing them as distro packages instead does not work:
# Arch puts them in /usr/share/zsh/plugins and Debian somewhere else again, and
# the box then silently ran without them (no zle-line-pre-redraw hooks, so a
# prompt misdraw was never repaired and Tab ate a line).
#
# Re-runs only when the list below changes (chezmoi hashes the script).

plugins="Aloxaf/fzf-tab zsh-users/zsh-autosuggestions zsh-users/zsh-syntax-highlighting zsh-users/zsh-history-substring-search"

command -v git >/dev/null 2>&1 || exit 0
[[ -d "${ZSH_CUSTOM:-$HOME/.oh-my-zsh/custom}" || -d "$HOME/.oh-my-zsh" ]] || exit 0

root="${ZSH_CUSTOM:-$HOME/.oh-my-zsh/custom}/plugins"
mkdir -p "$root"
for repo in $plugins; do
  name="${repo#*/}"
  if [[ -d "$root/$name/.git" ]]; then
    git -C "$root/$name" pull --ff-only || true
    continue
  fi
  echo "zsh plugin: cloning $name"
  git clone --depth=1 "https://github.com/$repo.git" "$root/$name" \
    || echo "zsh plugin: could not clone $name (offline?)" >&2
done
{{- end -}}
