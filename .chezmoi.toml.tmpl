{{ $machine := promptStringOnce . "machine" "Machine type (auto/laptop/workstation)" "auto" -}}
{{ $desktop := promptStringOnce . "desktop" "Desktop (auto/gnome/kde/hyprland)" "auto" -}}
{{ $terminal := promptStringOnce . "terminal" "Terminal (auto/ghostty/kitty/kwi)" "auto" -}}
{{ $role := promptStringOnce . "role" "Role (dev/dev-gaming/minimal)" "dev" -}}
{{ $gaming := promptStringOnce . "gaming" "Gaming machine? (true/false)" "false" -}}

[edit]
    command = "nano"

[git]
    autoCommit = false
    autoPush = false

[data]
    machine = {{ $machine | default "auto" | quote }}
    desktop = {{ $desktop | default "auto" | quote }}
    terminal = {{ $terminal | default "auto" | quote }}
    role = {{ $role | default "dev" | quote }}
    gaming = {{ eq $gaming "true" }}
