# Main zsh entrypoint. Detailed config lives in ~/.config/zsh/.

export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="robbyrussell"        # starship is initialized later
DISABLE_MAGIC_FUNCTIONS="true"
# ENABLE_CORRECTION="true"
COMPLETION_WAITING_DOTS="true"
# fzf keybindings path — portable across Arch (/usr/share/fzf) and Debian.
if [[ -d /usr/share/fzf ]]; then
  export FZF_BASE=/usr/share/fzf
elif [[ -d /usr/share/doc/fzf/examples ]]; then
  export FZF_BASE=/usr/share/doc/fzf/examples
fi

ZSH_CONFIG_DIR="${ZSH_CONFIG_DIR:-$HOME/.config/zsh}"

# Completion styles must be set before Oh My Zsh runs compinit.
[[ -r "$ZSH_CONFIG_DIR/pre-omz.zsh" ]] && source "$ZSH_CONFIG_DIR/pre-omz.zsh"

# Every plugin lives in one place: $ZSH_CUSTOM/plugins (git clone there, both on
# the host and in the dev box). oh-my-zsh loads them from this array only, so
# Arch's /usr/share/zsh/plugins packages and Debian's paths stop mattering.
#
# WHICH plugins is one list — ~/.config/zsh/plugins.txt — shared with
# install-shell.sh, the chezmoi repair hook and distrobox/provision-dev.sh, so
# there is exactly one place to add or remove one. Load order is file order, and
# that file keeps zsh-syntax-highlighting last (it wraps every widget bound
# before it). Built-in oh-my-zsh plugins are listed here and nowhere else.
plugins=(git fzf extract)
if [[ -r "$ZSH_CONFIG_DIR/plugins.txt" ]]; then
  while IFS= read -r plugin; do
    plugins+=("$plugin")
  done < <(sed -e 's/#.*//' -e 's/[[:space:]]//g' "$ZSH_CONFIG_DIR/plugins.txt" \
             | grep -v '^$' | sed -e 's|.*/||')
  unset plugin
else
  echo "warning: $ZSH_CONFIG_DIR/plugins.txt missing; run 'ucli chezmoi-apply'" >&2
  plugins+=(fzf-tab zsh-autosuggestions zsh-history-substring-search zsh-syntax-highlighting)
fi

# Only source oh-my-zsh if it was actually installed (install-shell.sh clones
# plugins but omz itself is installed by install-oh-my-zsh.sh).
if [[ -r "$ZSH/oh-my-zsh.sh" ]]; then
  source "$ZSH/oh-my-zsh.sh"
else
  echo "warning: oh-my-zsh not found at $ZSH; run 'ucli cli' to install" >&2
fi

# Your overrides first, so the UCLI_SHELL_ENABLE_* flags and aliases defined
# there win over the managed defaults in conf.d. Not chezmoi-managed: copy the
# example once (`cp ~/.config/zsh/local.zsh.example ~/.config/zsh/local.zsh`)
# and chezmoi will leave it alone from then on.
if [[ -r "$ZSH_CONFIG_DIR/local.zsh" ]]; then
  source "$ZSH_CONFIG_DIR/local.zsh"
fi

# Load modular config in numeric order.
for file in "$ZSH_CONFIG_DIR"/conf.d/*.zsh(N); do
  source "$file"
done

unset file
