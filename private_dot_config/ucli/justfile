set shell := ["bash", "-uc"]
set dotenv-load := false
# ujust parity: never echo comment lines from recipe bodies.
set ignore-comments

import 'recipes/fix.just'
import 'recipes/help.just'
import 'recipes/install.just'
import 'recipes/system.just'
import 'recipes/gnome.just'
import 'recipes/inventory.just'
import 'recipes/devbox.just'
import 'recipes/maintenance.just'

# Run the interactive chooser by default (like ujust with no args): groups, then
# recipes, in the same gum UI as every other ucli menu. `just --choose` (fzf,
# type-to-filter) stays as the fallback if the menu script is not deployed.
_default:
    #!/usr/bin/env bash
    set -euo pipefail
    menu="$HOME/.local/share/ucli/scripts/system/ucli-menu.sh"
    if [ -x "$menu" ]; then exec "$menu"; fi
    exec just --justfile "{{justfile()}}" --working-directory "{{justfile_directory()}}" --choose
