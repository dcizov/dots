# GNOME shell extensions enabled list — managed by chezmoi.
# Source: private_dot_config/ucli/settings/gnome/enabled-extensions.txt.tmpl
# Target: ~/.config/ucli/settings/gnome/enabled-extensions.txt
#
# Create this file by running:
#   ucli backup-gnome-settings   (uses: gnome-extensions list --enabled)
#
# Then chezmoi add it:
#   chezmoi add ~/.config/ucli/settings/gnome/enabled-extensions.txt
#
# Restore with:
#   ucli restore-gnome-settings   (reads this file and enables each extension)
#
# ArchWiki: https://wiki.archlinux.org/title/GNOME/Shell_extensions
# https://wiki.archlinux.org/title/GNOME

# Add one extension UUID per line, e.g.:
# dash-to-dock@micxgx.gmail.com
# caffeine@patapon.info
