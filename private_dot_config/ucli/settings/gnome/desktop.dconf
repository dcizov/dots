[a11y/interface]
high-contrast=false

[a11y/magnifier]
cross-hairs-length=58

[app-folders]
folder-children=['System', 'Utilities', 'YaST', 'Pardus']

[app-folders/folders/Pardus]
categories=['X-Pardus-Apps']
name='X-Pardus-Apps.directory'
translate=true

[app-folders/folders/System]
apps=['nm-connection-editor.desktop', 'org.gnome.baobab.desktop', 'org.gnome.DiskUtility.desktop', 'org.gnome.Logs.desktop', 'org.freedesktop.MalcontentControl.desktop', 'org.gnome.SystemMonitor.desktop', 'org.gnome.tweaks.desktop']
name='X-GNOME-Shell-System.directory'
translate=true

[app-folders/folders/Utilities]
apps=['org.gnome.Decibels.desktop', 'org.gnome.Connections.desktop', 'org.gnome.Papers.desktop', 'org.gnome.font-viewer.desktop', 'org.gnome.Loupe.desktop', 'org.gnome.Showtime.desktop']
name='X-GNOME-Shell-Utilities.directory'
translate=true

[app-folders/folders/YaST]
categories=['X-SuSE-YaST']
name='suse-yast.directory'
translate=true

[background]
color-shading-type='solid'
picture-options='zoom'
picture-uri='file:///home/wtfaq/.config/background'
picture-uri-dark='file:///home/wtfaq/.config/background'
primary-color='#1c1c1f'
secondary-color='#1c1c1f'

[input-sources]
sources=[('xkb', 'de')]
xkb-options=['terminate:ctrl_alt_bksp']

[interface]
accent-color='purple'
color-scheme='prefer-dark'
enable-animations=true
enable-hot-corners=false
gtk-theme='adw-gtk3-dark'
icon-theme='Papirus-Dark'

[notifications]
application-children=['org-gnome-software', 'com-shellyorg-shelly', 'org-gnome-shell-extensions-gsconnect', 'firefox', 'gnome-power-panel']

[notifications/application/com-shellyorg-shelly]
application-id='com.shellyorg.shelly.desktop'

[notifications/application/firefox]
application-id='firefox.desktop'

[notifications/application/gnome-power-panel]
application-id='gnome-power-panel.desktop'

[notifications/application/org-gnome-shell-extensions-gsconnect]
application-id='org.gnome.Shell.Extensions.GSConnect.desktop'

[notifications/application/org-gnome-software]
application-id='org.gnome.Software.desktop'

[screensaver]
color-shading-type='solid'
picture-options='zoom'
picture-uri='file:///usr/share/backgrounds/gnome/curvy-l.jxl'
primary-color='#8A8988'
secondary-color='#B8B7B6'
