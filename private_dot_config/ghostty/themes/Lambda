# ghostty theme: `theme = Lambda` in ~/.config/ghostty/config, found at
# ~/.config/ghostty/themes/Lambda.
#
# Only the two base colours and the 16 ANSI slots are set. Everything else
# (cursor, selection, borders) is ghostty's own default, which is derived
# from these — so the terminal behaves as before, in the new palette.
background = #1c1c1f
foreground = #d5d7d9

# slot 0-7 normal, 8-15 bright
palette = 0=#1c1c1f   # black         background
palette = 1=#df005f   # red           errors, deletions
palette = 2=#83b64f   # green         additions, executables
palette = 3=#efd25c   # yellow        warnings, the username
palette = 4=#00c6dc   # blue          directories, the path
palette = 5=#cb75f7   # magenta       the git branch
palette = 6=#1addb3   # cyan          the prompt arrow
palette = 7=#d5d7d9   # white         body text
palette = 8=#5b7683   # bright black  comments, autosuggestion
palette = 9=#ff5f8f   # bright red
palette = 10=#a6d97a  # bright green
palette = 11=#ffe98a  # bright yellow
palette = 12=#5ce6f2  # bright blue
palette = 13=#e0a3ff  # bright magenta
palette = 14=#5cf5d0  # bright cyan
palette = 15=#ffffff  # bright white

# ghostty >= 1.3.0: derive the 256-colour cube and the greyscale ramp from
# these 16 instead of the xterm defaults. Drop the line to keep xterm's.
palette-generate = true
