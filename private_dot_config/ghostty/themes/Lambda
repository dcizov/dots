# ghostty theme: `theme = Lambda` in ~/.config/ghostty/config,
# found at ~/.config/ghostty/themes/Lambda.
# Same 16 slots as ~/.config/kitty/themes/lambda.conf and
# ~/.local/share/konsole/Lambda.colorscheme, and the same palette
# as the starship prompt.

background            = #222e34
foreground            = #d5d7d9
cursor-color          = #1addb3
cursor-text           = #222e34
selection-background  = #2f4b56
selection-foreground  = #ffffff
minimum-contrast      = 1.1

# slot 0-7 normal, 8-15 bright
palette = 0=#222e34  # black    background
palette = 1=#df005f  # red      errors, deletions
palette = 2=#83b64f  # green    additions, executables
palette = 3=#efd25c  # yellow   warnings, the username
palette = 4=#00c6dc  # blue     directories, the path
palette = 5=#cb75f7  # magenta  the git branch
palette = 6=#1addb3  # cyan     the prompt arrow
palette = 7=#d5d7d9  # white    body text
palette = 8=#5b7683  # comments, autosuggestion
palette = 9=#ff5f8f  # bright red
palette = 10=#a6d97a  # bright green
palette = 11=#ffe98a  # bright yellow
palette = 12=#5ce6f2  # bright blue
palette = 13=#e0a3ff  # bright magenta
palette = 14=#5cf5d0  # bright cyan
palette = 15=#ffffff  # bright white

# ghostty >= 1.3.0: derive 256-colour cube + greyscale from these 16
palette-generate = true
