# ghostty theme: `theme = Lambda` in ~/.config/ghostty/config, found at
# ~/.config/ghostty/themes/Lambda.
#
# Only the two base colours and the 16 ANSI slots are set. Everything else
# (cursor, selection, borders) is ghostty's own default, which is derived
# from these — so the terminal behaves as before, in the new palette.
background = #1c1c1f
foreground = #d5d7d9

# slot 0-7 normal, 8-15 bright
palette = 0=#1c1c1f
palette = 1=#df005f
palette = 2=#83b64f
palette = 3=#efd25c
palette = 4=#00c6dc
palette = 5=#cb75f7
palette = 6=#1addb3
palette = 7=#d5d7d9
palette = 8=#5b7683
palette = 9=#ff5f8f
palette = 10=#a6d97a
palette = 11=#ffe98a
palette = 12=#5ce6f2
palette = 13=#e0a3ff
palette = 14=#5cf5d0
palette = 15=#ffffff

# ghostty >= 1.3.0: derive the 256-colour cube and the greyscale ramp from
# these 16 instead of the xterm defaults. Drop the line to keep xterm's.
palette-generate = true
