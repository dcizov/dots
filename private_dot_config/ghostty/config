# Ghostty terminal configuration
# ~/.config/ghostty/config
#
# Constraints observed:
# - No unsupported fields (window-title, blur-background rejected by Ghostty 1.4.0)
# - No inline # comments on palette = lines

# Appearance
theme = Lambda
font-family = JetBrainsMono Nerd Font
background = #1c1c1f

# Window padding (valid Ghostty fields)
window-padding-x = 4
window-padding-y = 4

# Cursor style
cursor-style = block
