# optional per-machine tunables for the `dev` distrobox
# chezmoi-managed · read by ~/.config/distrobox/provision-dev.sh on every run
#
# Uncomment to override the defaults. Any change here re-provisions the box on
# the next `chezmoi apply` (the reconcile hashes this file too).
#
# NODE_CHANNEL=lts      # lts | 22 | 24 | 26   (lts = 24.x today)
# PHP_BRANCH=8.5        # 8.2 | 8.3 | 8.4 | 8.5 (from deb.sury.org)
# DEVBOX_SKIP_APT_TOOLING=1   # skip the cosmetic package list (zsh/fzf/eza/…)
# DEVBOX_SSH_PORT=2222  # sshd port inside the box (Remote-SSH targets this)
# STARSHIP_VERSION=1.27.0  # pin starship in the box; default = the host's version
